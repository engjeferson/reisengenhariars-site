# Dominios (os dois precisam de registro DNS tipo A apontando para o IP da VPS)
CAP_DOMAIN=cap.seudominio.com.br
S3_DOMAIN=s3.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Segredos: gerados por ./setup.sh (nao commitar o .env)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=cap-admin
MINIO_ROOT_PASSWORD=
DATABASE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
MEDIA_SERVER_WEBHOOK_SECRET=

# Opcional: sem e-mail configurado, o link de login aparece em `docker compose logs cap-web`
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
# Opcional: transcricao
ASSEMBLY_API_KEY=
ASSEMBLY_BASE_URL=
# Opcional: login com Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
